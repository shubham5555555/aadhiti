# Copy to .env.local (never commit real values) and add the same keys in Vercel → Settings → Environment Variables.

# --- Google Gemini: AI answers (website chat + WhatsApp) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- ElevenLabs: call bot voices ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_HI=rk6oGq9uo683FNzBfKLb
ELEVENLABS_VOICE_MALE=bUTE2M5LdnqaUCd5tJB3
ELEVENLABS_STABILITY=0.4
ELEVENLABS_STYLE=0.4
ELEVENLABS_SPEED=0.97

# --- WATI: WhatsApp bot (/api/wati/webhook) ---
# API token from WATI → API Docs / Connector → API (needs permission to send conversation messages).
WATI_API_TOKEN=
# Only change if WATI gives you a different API host.
# WATI_API_URL=https://live-mt-server.wati.io
# A long random secret; generate with:  openssl rand -hex 24
# Then set the WATI webhook URL to https://<your-domain>/api/wati/webhook?token=<this secret>
WATI_WEBHOOK_SECRET=

# "Talk to a person": the WATI team member (their WATI login email) and/or team to assign chats to.
# Leave both empty to keep this off; the bot then points women to 181.
WATI_HANDOFF_EMAIL=
# WATI_HANDOFF_TEAM=

# Link shown in WhatsApp replies (defaults to the Vercel production domain).
# SITE_URL=https://aadhiti.vercel.app

# --- Upstash Redis (Vercel Marketplace → Upstash): WhatsApp chat memory + duplicate filtering ---
# Adding the integration in Vercel sets these automatically (KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- WhatsApp support operations ---
# Staff who may explicitly accept requests by sending #accept in the WATI chat.
WATI_SUPPORT_OPERATOR_EMAILS=
# Protects /api/wati/operations; different from the public webhook token.
WATI_OPERATIONS_SECRET=
# Optional sender channel for approved reminder templates.
WATI_CHANNEL=
# Required for opt-in reminders: 32 random bytes as 64 hex characters.
# Generate locally: openssl rand -hex 32
WATI_REMINDER_KEY=
# Protects /api/cron/reminders. Vercel Cron sends this as a bearer token.
CRON_SECRET=

# Default voice for all languages; male calls retain ELEVENLABS_VOICE_MALE.
ELEVENLABS_VOICE_DEFAULT=2K3jPCTBDyFFo3BVyBpG
